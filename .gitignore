# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ANY file starting with .env is ignored (.env, .env.local,
# .env.production, .env.development.local, etc). This is the main place API
# keys, database URLs, and other secrets end up in a Next.js project, so this
# pattern is intentionally broad. If a specific env file is ever safe and
# meant to be shared (e.g. a committed .env.example with no real values),
# re-allow it explicitly below with a `!` line instead of narrowing this rule.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS-generated cruft (Windows/macOS file-manager metadata — never useful in git)
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# editor/IDE local settings — machine-specific, not project config
.vscode/
.idea/
*.swp

# local tooling config that can carry secrets (API keys for MCP servers,
# machine-specific permission grants) — safe to ignore even though neither
# exists in this repo yet, so a future local file never gets committed by accident
.claude/settings.local.json
.mcp.json
